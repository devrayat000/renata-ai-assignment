# Get a free key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: a Turso database for deploys. Leave empty to use data/mastra.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: offer the search (RAG) agent in the chat. Run `bun run ingest` first.
ENABLE_RAG_AGENT=false
