# Get a free key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional, search (RAG) agent only. Offer it in the chat; run `bun run ingest` first.
ENABLE_RAG_AGENT=false
# Optional, search agent only: store its vectors and graph in Turso instead of
# data/mastra.db. Needed for the search agent on Vercel.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
